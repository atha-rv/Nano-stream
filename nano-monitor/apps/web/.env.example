# Copy to .env.local. Empty values below require your own service credentials.
# Preview uses the known local Supabase demo defaults from .env.development;
# it never bypasses authentication or fulfils a payment.
TEMPLATE_PREVIEW_ENABLED=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=Foundation
NEXT_PUBLIC_SITE_TITLE=Foundation
NEXT_PUBLIC_SITE_DESCRIPTION="Your workspace."

# Replace both together when connecting a hosted Supabase project.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_PRIVATE_SERVICE_ROLE_KEY

# Password auth is enabled. Enable Google only after setting it up in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=false
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_BUSINESS_ID=
DODO_PAYMENTS_PRODUCT_ID=
