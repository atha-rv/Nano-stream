{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test:foundation": "node --test tests/*.test.mjs",
    "test:integration": "pnpm with-env:test node --test tests/*.integration.mjs",
    "analyze": "ANALYZE=true pnpm run build",
    "build": "pnpm with-env next build",
    "build:test": "pnpm with-env:test cross-env TEMPLATE_PREVIEW_ENABLED=true next build",
    "clean": "git clean -xdf .next .turbo node_modules",
    "dev": "pnpm with-env next dev | pino-pretty -c",
    "start": "pnpm with-env next start",
    "start:test": "pnpm with-env:test cross-env TEMPLATE_PREVIEW_ENABLED=true next start",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ./.env.local --",
    "with-preview": "dotenv -e ./.env.local -e ./.env.development -- cross-env TEMPLATE_PREVIEW_ENABLED=true NEXT_PUBLIC_CI=true GIT_HASH=local-preview",
    "with-env:test": "dotenv -e ./.env.test --",
    "supabase": "supabase",
    "supabase:start": "supabase status || supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "supabase:test": "supabase db test",
    "supabase:db:lint": "supabase db lint",
    "supabase:deploy": "supabase link --project-ref $SUPABASE_PROJECT_REF && supabase db push",
    "supabase:typegen": "pnpm run supabase:typegen:packages && pnpm run supabase:typegen:app",
    "supabase:typegen:packages": "supabase gen types typescript --local > ../../packages/supabase/src/database.types.ts",
    "supabase:typegen:app": "supabase gen types typescript --local > ./lib/database.types.ts",
    "supabase:db:dump:local": "supabase db dump --local --data-only"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@kit/accounts": "workspace:*",
    "@kit/auth": "workspace:*",
    "@kit/i18n": "workspace:*",
    "@kit/next": "workspace:*",
    "@kit/supabase": "workspace:*",
    "@kit/ui": "workspace:*",
    "@marsidev/react-turnstile": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "date-fns": "catalog:",
    "dodopayments": "2.52.0",
    "lucide-react": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "next-sitemap": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "recharts": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@electric-sql/pglite": "0.3.14",
    "@kit/tsconfig": "workspace:*",
    "@next/bundle-analyzer": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "autoprefixer": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "dotenv-cli": "catalog:",
    "pino-pretty": "catalog:",
    "standardwebhooks": "1.0.0",
    "supabase": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "catalog:",
    "typescript": "catalog:"
  },
  "browserslist": [
    "last 1 versions",
    "> 0.7%",
    "not dead"
  ]
}
